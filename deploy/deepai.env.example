# DeepAI Code gateway — runtime environment for systemd
# Installed by deploy/install.sh; edit then `systemctl restart deepai-gateway`.

# Bind address: 0.0.0.0 so the Open WebUI container can reach the gateway.
DEEPAI_GATEWAY_HOST=0.0.0.0
DEEPAI_GATEWAY_PORT=8787
# Admin token: generated on install. Rotate by editing this file + restarting.
DEEPAI_GATEWAY_TOKEN=change-me
DEEPAI_GATEWAY_DATA=/var/lib/deepai2api/data

# Where the WebUI fork lives (gateway redirects "/" here when set).
DEEPAI_WEBUI_URL=http://127.0.0.1:3000

# Bulk signup workers: one venv, one directory per factory.
# Each factory reads its OWN variables first; DEEPAI_* never redirects the Poe
# worker (and POE_* never redirects the DeepAI worker).
DEEPAI_PYTHON=/opt/deepai2api/.venv/bin/python
DEEPAI_REGISTER_DIR=/opt/deepai2api/tools/deepai-reg
POE_PYTHON=/opt/deepai2api/.venv/bin/python
POE_REGISTER_DIR=/opt/deepai2api/tools/poe-reg

# Optional: egress proxy for signup traffic and upstream calls.
# HTTPS_PROXY=http://127.0.0.1:10808
# HTTP_PROXY=http://127.0.0.1:10808
# NO_PROXY=localhost,127.0.0.1

# ---- 各条号池线的注册机（每线一套 PYTHON + REGISTER_DIR）----
ALLMODELS_PYTHON=/opt/deepai2api/.venv/bin/python
ALLMODELS_REGISTER_DIR=/opt/deepai2api/tools/allmodels-reg
CLEVERAI_PYTHON=/opt/deepai2api/.venv/bin/python
CLEVERAI_REGISTER_DIR=/opt/deepai2api/tools/cleverai-reg
# Clever AI 的 App Check 令牌要靠浏览器换；没有浏览器就只能用 capsolver / 手贴令牌
# CLEVERAI_APPCHECK_PROVIDER=browser
# CLEVERAI_CAPTCHA_KEY=
# CLEVERAI_APPCHECK_TOKEN=
GABAI_PYTHON=/opt/deepai2api/.venv/bin/python
GABAI_REGISTER_DIR=/opt/deepai2api/tools/gabai-reg

# Provider 运行时（/p/<provider>/v1/*）：留空 = 全装
# DCG_PROVIDERS=wavespeed,novita,moonai,zo,blackbox

# 域名邮箱（catch-all），四条线共用同一个 IMAP
# CLEVERAI_IMAP_HOST=imap.example.com
# CLEVERAI_IMAP_USER=catchall@example.com
# CLEVERAI_IMAP_PASSWORD=
# ALLMODELS_IMAP_HOST / ALLMODELS_IMAP_USER / ALLMODELS_IMAP_PASSWORD

# ---- proxyscrape 代理池（产物是出口，自动分发给其它注册机）----
PROXYSCRAPE_PYTHON=/opt/deepai2api/.venv/bin/python
PROXYSCRAPE_REGISTER_DIR=/opt/deepai2api/tools/proxyscrape-reg
# PROXYSCRAPE_CAPTCHA_PROVIDER=browser
# PROXYSCRAPE_CAPTCHA_KEY=

# ---- jev-ai.org Key 池（产物是 sk-glm5-…，自动写 data/keys/jevai.*）----
JEVAIS_PYTHON=/opt/deepai2api/.venv/bin/python
JEVAIS_REGISTER_DIR=/opt/deepai2api/tools/jevai-reg
# JEVAIS_MAIL_DOMAIN=
