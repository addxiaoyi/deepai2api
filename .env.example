# 复制为 .env 后按需修改；docker compose 与网关都会读取
#
# 网关地址：Open WebUI 在容器里，访问宿主机不能用 127.0.0.1
DEEPAI_GATEWAY_URL=http://host.docker.internal:8787
# 网关管理口令（网关启动时打印，或 node src/index.mjs --show-admin-token）
DEEPAI_GATEWAY_TOKEN=change-me-to-a-strong-token

# Open WebUI 对外端口
OPENWEBUI_PORT=3000

# ---- 网关侧（node src/index.mjs 读取的环境变量）----
# DEEPAI_GATEWAY_HOST=127.0.0.1
# DEEPAI_GATEWAY_PORT=8787
# DEEPAI_GATEWAY_DATA=./data
# DEEPAI_DEFAULT_MODEL=deepseek-v4.1-flash
# DEEPAI_MAX_CONCURRENT=1
# DEEPAI_GATEWAY_LOG=info
# DEEPAI_WEBUI_URL=http://127.0.0.1:3000
# DEEPAI_MODEL_ALIASES={"gpt-4o":"glm-5.3"}
# HTTPS_PROXY=http://127.0.0.1:10808
# NO_PROXY=localhost,127.0.0.1

# ---- Allmodels 号池 / 注册机（tools/allmodels-reg）----
# ALLMODELS_BASE_URL=https://dash.allmodels.io
# ALLMODELS_API_BASE=https://api.allmodels.io/v1
# ALLMODELS_CAPTCHA_PROVIDER=capsolver   # none | capsolver | 2captcha | browser | manual
# ALLMODELS_CAPTCHA_KEY=...
# ALLMODELS_ENGINE=auto                  # protocol | browser | auto
# ALLMODELS_BROWSER_STACK=auto           # auto | camoufox | patchright | playwright
# ALLMODELS_CDP=http://127.0.0.1:50325   # 接管外部指纹浏览器（AdsPower/BitBrowser…）
# ALLMODELS_IMAP_HOST=imap.example.com
# ALLMODELS_IMAP_USER=catchall@example.com
# ALLMODELS_IMAP_PASSWORD=...
# ALLMODELS_GATEWAY_URL=http://127.0.0.1:8787
# ALLMODELS_GATEWAY_TOKEN=${DEEPAI_GATEWAY_TOKEN}
# ALLMODELS_PYTHON=python
# ALLMODELS_REGISTER_DIR=./tools/allmodels-reg
# ---- Clever AI Hub 号池 / 注册机（tools/cleverai-reg）----
# CLEVERAI_BASE_URL=https://cleverai.app
# CLEVERAI_API_BASE=https://api.cleverai.app
# CLEVERAI_CHAT_ENGINE=openai-gpt-6-luna
# CLEVERAI_ENGINE=auto                   # protocol | browser | auto
# CLEVERAI_APPCHECK_PROVIDER=browser     # browser | capsolver | manual
# CLEVERAI_APPCHECK_TOKEN=               # manual: 直接给一枚 App Check JWT
# CLEVERAI_CAPTCHA_KEY=                  # capsolver clientKey
# CLEVERAI_BROWSER_STACK=auto            # auto | camoufox | patchright | playwright
# CLEVERAI_CDP=http://127.0.0.1:50325
# CLEVERAI_MAIL_DOMAIN=example.com       # catch-all 域名
# CLEVERAI_IMAP_HOST=imap.example.com
# CLEVERAI_IMAP_USER=catchall@example.com
# CLEVERAI_IMAP_PASSWORD=...
# CLEVERAI_GATEWAY_URL=http://127.0.0.1:8787
# CLEVERAI_GATEWAY_TOKEN=${DEEPAI_GATEWAY_TOKEN}
# CLEVERAI_PYTHON=python
# CLEVERAI_REGISTER_DIR=./tools/cleverai-reg
# CLEVERAI_ACCEPT_PLACEHOLDER=0          # 1 = 不标记上游占位回答

# ---- Gab AI 号池 / 注册机（tools/gabai-reg）----
# GABAI_BASE_URL=https://gab.ai
# GABAI_API_BASE=https://gab.ai/v1
# GABAI_ENGINE=auto                     # protocol | browser | auto
# GABAI_BROWSER_STACK=auto
# GABAI_CDP=http://127.0.0.1:50325
# GABAI_CAPTCHA_PROVIDER=none           # none | capsolver | manual
# GABAI_CAPTCHA_KEY=...
# GABAI_REGISTER_DIR=./tools/gabai-reg
# GABAI_PYTHON=python

# ---- Provider 运行时（/p/<provider>/v1/*）----
# DCG_PROVIDERS=wavespeed,novita,moonai,zo,blackbox   # 留空 = 全装
# DCG_PROVIDER_ENDPOINTS={"moonai":{"apiBase":"http://127.0.0.1:9999"}}

# ---- Poe 号池 / 注册机（tools/poe-reg）----
# POE_REGISTER_DIR=./tools/poe-reg
# POE_PYTHON=python
# POE_SMS_PROVIDER=off                  # 接码平台（phone_required 那一关用）
# POE_SMS_API_KEY=...
